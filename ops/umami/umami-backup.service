[Unit]
Description=Back up the Umami PostgreSQL database
After=docker.service umami-guard.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/umami-backup
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/umami
